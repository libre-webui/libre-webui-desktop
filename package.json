{
  "name": "libre-webui-desktop",
  "version": "0.30.0",
  "description": "Libre WebUI Desktop Application",
  "main": "electron/main.js",
  "author": "Libre WebUI Contributors <contact@librewebui.org>",
  "license": "Apache-2.0",
  "private": true,
  "librewebui": {
    "repository": "https://github.com/libre-webui/libre-webui.git",
    "tag": "v0.30.0"
  },
  "scripts": {
    "prepare:app": "node scripts/prepare-app.mjs",
    "dev": "NODE_ENV=development electron .",
    "pack": "npm run prepare:app && electron-builder --dir",
    "build:mac": "npm run prepare:app && electron-builder build --mac --arm64 --publish never",
    "build:win": "npm run prepare:app && electron-builder build --win --publish never",
    "build:linux": "npm run prepare:app && electron-builder build --linux --publish never",
    "verify:mac": "bash scripts/verify-macos-artifact.sh",
    "icons": "node scripts/generate-icons.js",
    "test": "node --test scripts/test-desktop-packaging.mjs"
  },
  "devDependencies": {
    "electron": "41.10.3",
    "electron-builder": "26.15.7",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.1"
  }
}
